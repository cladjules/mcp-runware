{
  "name": "mcp-runware",
  "version": "1.0.0",
  "description": "MCP server for Runware AI image generation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-runware": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && cp -r src/data dist/",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsc && cp -r src/data dist/ && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector",
    "start:http": "MCP_TRANSPORT=http node dist/index.js",
    "fetch-models": "python3 scripts/fetch_curated_models.py",
    "test:simple": "tsx test-simple.ts"
  },
  "keywords": [
    "mcp",
    "runware",
    "ai",
    "image-generation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@runware/sdk-js": "^1.2.4",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.20.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "@vercel/node": "^5.6.6",
    "typescript": "^5.9.3"
  }
}
