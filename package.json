{
  "name": "mcp-runware",
  "version": "1.0.0",
  "description": "MCP server for Runware AI image generation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-runware": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && cp -r src/data dist/",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsc && cp -r src/data dist/ && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector",
    "start:http": "MCP_TRANSPORT=http node dist/index.js",
    "fetch-models": "python3 scripts/fetch_curated_models.py"
  },
  "keywords": [
    "mcp",
    "runware",
    "ai",
    "image-generation"
  ],
  "author": "",
  "license": "MIT",
  "overrides": {
    "mcp-handler": {
      "@modelcontextprotocol/sdk": "^1.26.0"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@runware/sdk-js": "^1.2.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "mcp-handler": "^1.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.1.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.2",
    "@vercel/node": "^4.0.0",
    "typescript": "^5.9.3"
  }
}
